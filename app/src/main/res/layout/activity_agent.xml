<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Agent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/tv_data_usage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data used: 0.00 MB"
                android:textSize="11sp"
                android:textColor="#4CAF50"
                android:fontFamily="monospace" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_toggle_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖥️ بزرگ‌نمایی"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_agent_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History 📂"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Prompt Input -->
    <EditText
        android:id="@+id/et_agent_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="درخواست خود را وارد کنید..."
        android:minLines="1"
        android:maxLines="3"
        android:scrollbars="vertical"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:background="@android:drawable/edit_text"
        android:padding="6dp"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btn_agent_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="شروع ایجنت (Start)"
            android:textSize="12sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_agent_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="توقف (Stop)"
            android:textSize="12sp"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Progress Bar & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        android:id="@+id/layout_progress">
        <TextView
            android:id="@+id/tv_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:textSize="14sp"
            android:layout_marginEnd="6dp"/>
        <ProgressBar
            android:id="@+id/pb_task_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="#2196F3" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_agent_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#2196F3"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:padding="2dp"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <!-- Log View (وزن 1) -->
    <ScrollView
        android:id="@+id/scroll_logs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="6dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_agent_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="Agent is ready..." />
    </ScrollView>

    <!-- WebView (وزن 1.5 برای بزرگتر بودن) -->
    <FrameLayout
        android:id="@+id/frame_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:background="#FFFFFF">
        <WebView
            android:id="@+id/agent_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />
        <ProgressBar
            android:id="@+id/agent_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
