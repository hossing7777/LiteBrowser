<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI Autonomous Agent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_agent_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="درخواست خود را وارد کنید (مثلاً: یک فایل پایتون بساز...)"
        android:minLines="2"
        android:gravity="top|start"
        android:background="@android:drawable/edit_text"
        android:padding="8dp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_agent_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="شروع ایجنت (Start)"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_agent_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="Agent is ready..." />
    </ScrollView>

    <!-- ✅ وب‌ویو به اینجا منتقل شد تا در صورت نیاز لاگین کنید -->
    <WebView
        android:id="@+id/agent_webview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#EEEEEE" />
</LinearLayout>
