<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI Autonomous Agent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_agent_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="درخواست خود را وارد کنید (مثلاً: یک فایل پایتون بساز...)"
        android:minLines="2"
        android:gravity="top|start"
        android:background="@android:drawable/edit_text"
        android:padding="8dp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_agent_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="شروع ایجنت (Start)"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <!-- ✅ بخش درصد پیشرفت پروژه -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:id="@+id/layout_progress">

        <TextView
            android:id="@+id/tv_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <ProgressBar
            android:id="@+id/pb_task_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="#2196F3" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_agent_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#2196F3"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:padding="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_agent_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="Agent is ready..." />
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#DDDDDD"
        android:padding="2dp">
        
        <WebView
            android:id="@+id/agent_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />
            
        <ProgressBar
            android:id="@+id/agent_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
